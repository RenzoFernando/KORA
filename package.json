{
  "name": "korlambda",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5188 --strictPort",
    "build": "tsc -b && vite build && node --experimental-strip-types scripts/build-seo.mjs && node scripts/build-sw.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4174",
    "test": "node --experimental-strip-types --test tests/*.test.ts && node --experimental-strip-types tests/backend.test.mjs",
    "format": "prettier --write src tests *.json *.ts *.html",
    "format:check": "prettier --check src tests *.json *.ts *.html",
    "lint": "eslint src tests/*.ts scripts *.ts *.js --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "test:seo": "node --experimental-strip-types scripts/check-seo.mjs"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.0.5"
  }
}
